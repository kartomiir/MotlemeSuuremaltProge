from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor, ColorSensor, UltrasonicSensor, ForceSensor
from pybricks.parameters import Button, Color, Direction, Port, Side, Stop
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch, hub_menu
keskus = PrimeHub()
tooriist_vasak = Motor(Port.A)
tooriist_parem = Motor(Port.E)
parem_mootor = Motor(Port.F)
vasak_mootor = Motor(Port.B, Direction.COUNTERCLOCKWISE)  # yks mootor peab olema vastupaeva, et soitmine oigesti tootaks
soidu_baas = DriveBase(vasak_mootor, parem_mootor, wheel_diameter=49.5, axle_track=110)  # Axle track ehk telje roopmelaius on pikkus nende punktide vahel mis ratastel vastu maad on
"""
Taiesti mehhaaniline, pole mootoreid vaja peale soidumootorite.
"""
soidu_baas.settings(straight_speed=811, straight_acceleration=900)
soidu_baas.settings(turn_rate=811, turn_acceleration=900)
soidu_baas.straight(755)
soidu_baas.straight(-800)

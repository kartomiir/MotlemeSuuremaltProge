from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor, ColorSensor, UltrasonicSensor, ForceSensor
from pybricks.parameters import Button, Color, Direction, Port, Side, Stop
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch, hub_menu
hub = PrimeHub()
tool_left = Motor(Port.A)
tool_right = Motor(Port.E)
right_motor = Motor(Port.F)
left_motor = Motor(Port.B, Direction.COUNTERCLOCKWISE)  # One motor needs to be counterclockwise for driving to work correctly.
drive_base = DriveBase(left_motor, right_motor, wheel_diameter=49.5, axle_track=122)  # small: 108 // Axle track is the distance between the two points where wheels touch the ground
"""
Robot makes a left turn when drive_base.turn() < 0, a right turn when it is greater than 0.
drive_base.straight() is in millimeters.
drive_base.turn() is in degrees.
drive_base.settings(straight_speed=x, straight_acceleration=y) For changing max speed and acceleration
drive_base.settings(turn_rate=x, turn_acceleration=y) For changing max turning speed and turning acceleration
"""
drive_base.use_gyro(True)  # Gyro works
def bothmotors(speed, time):
    left_motor.run(speed)
    right_motor.run(speed)
    wait(time)
    left_motor.stop()
    right_motor.stop()
chosen = hub_menu("1", "2", "3", "4", "5", "6", "X")  # Selection screen.
def prh():  # PRH as in Pitch, Roll ja Heading. Mainly used for controlling the turning.
    heading = hub.imu.heading()  # How much the robot has turned in degrees.
    pitch, roll = hub.imu.tilt()
    print(pitch, roll, heading)
def distance():
    print(drive_base.distance())
def batterycheck():
    voltage = hub.battery.voltage()
    current = hub.battery.current()
    for number in range(6):
        print(hub.battery.current())
        print(hub.battery.voltage())
        hub.display.text(text=f"{voltage}", on=500, off=50)
        wait(3000)

def wheeliewashy():  # Used for washing the wheels.
    drive_base.use_gyro(False)
    drive_base.settings(straight_speed=749, straight_acceleration=100)  # Slow acceleration for the drama.
    drive_base.straight(65535)

def specialturn(turn):
    drive_base.settings(turn_rate=1000, turn_acceleration=1000)
    drive_base.turn(turn - hub.imu.heading()) # Turn Sahur
    for beautiful0100101101100001011100100111010001101111010011110100111001000111010011110100000101010100010001010100010001010000010011000101001101001111010010110011111100001010flower in range(3):
        while hub.imu.heading() < turn - 0.4:
            drive_base.turn(1)
            prh()
        while hub.imu.heading() > turn + 0.4:
            drive_base.turn(-1)
            prh()

